# Supabase - Get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For running migrations (scripts/migrate.mjs)
# Get PAT from https://supabase.com/dashboard/account/tokens
SUPABASE_PAT=sbp_xxxxxxxx
SUPABASE_PROJECT_REF=your-project-ref

# Resend - https://resend.com/api-keys (optional, for email notifications)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=TaskFlow <noreply@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
